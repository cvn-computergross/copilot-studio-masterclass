        {
         "label": "Da verificare",
         "icon": "git-branch",
         "fam": "system",
         "sub": "Classifica contiene Incerta?",
         "branches": [
          {
           "label": "Sì",
           "fam": "platform",
           "steps": [
            {
             "label": "Avvisa verifica manuale",
             "icon": "logo:outlook",
             "fam": "tools",
             "sub": "Send an email (V2)",
             "file": "outlook.png"
            }
           ]
          },
          {
           "label": "No",
           "fam": "neutral",
           "steps": [
            {
             "label": "Fine senza azioni",
             "icon": "x-circle",
             "fam": "system",
             "sub": "RispostaAutomatica o NonPertinente"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    },
    {
